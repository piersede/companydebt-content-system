{"detail_id": "n34", "detail": "A Restructuring Plan, introduced by the Corporate Insolvency and Governance Act 2020 (CIGA 2020) establishing Part 26A of the Companies Act 2006, is a court-sanctioned process for viable companies allowing a compromise with creditors and/or shareholders. It can impose a plan on dissenting creditor classes, known as 'cross-class cram down', if the court deems it 'fair and equitable', with approval typically requiring a majority in number representing 75% in value within each class.", "category": "Alternatives / Options", "provider": "Restructuring Plan", "card_name": "Restructuring Plan (CIGA 2020)", "value": "75%", "source_urls": ["https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQGmlen8l16HHsNQQjklyOurHAtEmdNjAdiAG0h4MrWeAbap9Zx4pT9MT3BdxxDYekJbkfKGVFiN_d9rgivtnCWgEE3JjA1rkszDKrTHm9UfSV5ej5RYjDlu3EKwh93FGYmuPTXZRmUni1aLfyiguvk5fAwf0k0kQUvKhqTMJMGzICT88VKhHUJ0iyRdSbyPugzVBbaovamEVyMj72Zvg8DjxOiSl8SQcBfKOpLp"], "mentioned_by": ["gemini · usecase-4"], "article_status": "missing", "recommended_display_format": "comparison_table_column", "recommended_action": "", "priority": "medium", "needs_primary_verification": true, "source_required": true, "last_checked_required": true, "editorial_note": "", "verification_status": "unverified", "verified_source_url": "", "verified_quote": "", "verify_date": "", "evidence_tier": "", "notes": "", "cannibalisation_risk": false, "cannibal_owner_url": ""}
