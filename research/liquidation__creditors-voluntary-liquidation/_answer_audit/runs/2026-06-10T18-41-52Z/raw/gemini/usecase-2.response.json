            "confidence_scores": null,
            "grounding_chunk_indices": [
              13
            ],
            "segment": {
              "start_index": 3202,
              "end_index": 3307,
              "part_index": null,
              "text": "It is important to note that the liquidator's fees are paid before unsecured creditors receive any funds."
            }
          },
          {
            "confidence_scores": null,
            "grounding_chunk_indices": [
              0,
              13
            ],
            "segment": {
              "start_index": 3429,
              "end_index": 3597,
              "part_index": null,
              "text": "*   **Directors' Redundancy Entitlement:** Many directors who were on the company payroll may be eligible for redundancy pay, notice pay, unpaid wages, and holiday pay."
            }
          },
          {
            "confidence_scores": null,
            "grounding_chunk_indices": [
              0,
              13
            ],
            "segment": {
              "start_index": 3598,
              "end_index": 3834,
              "part_index": null,
              "text": "This is a government-backed scheme, and while these payments are made to directors personally and cannot directly fund the CVL upfront, the funds can often cover most or all of the liquidation costs, especially the pre-appointment fees."
            }
          },
          {
            "confidence_scores": null,
            "grounding_chunk_indices": [
              13
            ],
            "segment": {
              "start_index": 3835,
              "end_index": 3939,
              "part_index": null,
              "text": "Eligibility typically requires working over 16 hours per week and being employed for at least two years."
            }
          },
          {
            "confidence_scores": null,
            "grounding_chunk_indices": [
              4,
              6,
              13,
              7
            ],
            "segment": {
              "start_index": 3940,
              "end_index": 4189,
              "part_index": null,
              "text": "*   **Directors' Personal Contributions:** If the company has no assets and the director is ineligible for redundancy pay, directors may need to make personal contributions to cover the liquidation costs, particularly the fixed pre-appointment fees."
            }
          },
          {
            "confidence_scores": null,
            "grounding_chunk_indices": [
              0
            ],
            "segment": {
              "start_index": 4190,
              "end_index": 4255,
              "part_index": null,
              "text": "Some insolvency firms may offer payment plans to spread the cost."
            }
          },
          {
            "confidence_scores": null,
            "grounding_chunk_indices": [
              13
            ],
            "segment": {
              "start_index": 4256,
              "end_index": 4360,
              "part_index": null,
              "text": "*   **Occasional Creditor Contributions:** In rare circumstances, creditors may contribute to the costs."
            }
          },
          {
            "confidence_scores": null,
            "grounding_chunk_indices": [
              7,
              2
            ],
            "segment": {
              "start_index": 4362,
              "end_index": 4547,
              "part_index": null,
              "text": "Directors are encouraged to seek advice from a licensed insolvency practitioner early, as delaying action can worsen the situation and potentially increase costs and personal liability."
            }
          },
          {
            "confidence_scores": null,
            "grounding_chunk_indices": [
              7
            ],
            "segment": {
              "start_index": 4548,
              "end_index": 4680,
              "part_index": null,
              "text": "Maintaining accurate financial records and cooperating with the liquidator can also help streamline the process and reduce expenses."
            }
          }
        ],
