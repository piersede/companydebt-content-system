    "raw": "<!-- wp:shortcode -->\n<p>[wp_sitemap_page only=\"page\"]</p>\n<!-- /wp:shortcode -->\n\n<!-- wp:shortcode -->\n<p>[wp_sitemap_page only=\"post\"]</p>\n<!-- /wp:shortcode -->"
