# CompanyDebt outreach conductor — environment.
# The conductor auto-loads the repo-root .env first, then outreach/.env (this file's
# real sibling). Repo-root already holds MONDAY_API_KEY. Add the keys below to whichever
# .env you prefer (outreach/.env is gitignored via the repo .gitignore *.env rule).

# --- Monday (outreach board — SEPARATE from the Content Rework Tracker) ---
# MONDAY_API_KEY is read from the repo-root .env already.
OUTREACH_BOARD_ID=                      # id of the NEW Outreach board (see README §Setup)
# Column ids on that board (fill after creating the board; `conductor boardcols` prints them)
OUTREACH_COL_STATUS=
OUTREACH_COL_EMAIL=
OUTREACH_COL_ASSET_URL=
OUTREACH_COL_ARTICLE_URL=
OUTREACH_COL_NOTES=
OUTREACH_COL_REJECT_REASON=
OUTREACH_COL_LAST_CONTACTED=
OUTREACH_COL_CITED_SOURCE=

# --- Drafting ---
# Provider auto-resolves: Anthropic if ANTHROPIC_API_KEY is set, else Gemini if GEMINI_API_KEY
# is set. Force it with OUTREACH_PROVIDER=gemini|anthropic. GEMINI_API_KEY is already in the
# repo-root .env, so drafting works with no extra key (default model gemini-2.5-pro).
OUTREACH_PROVIDER=gemini
# ANTHROPIC_API_KEY=                     # only if you switch to metered Anthropic billing
# OUTREACH_DRAFT_MODEL=gemini-2.5-pro    # override the per-provider default (e.g. gemini-3.1-pro-preview)

# --- Contact enrichment (Hunter.io) — optional; item halts to 'To research' if absent ---
HUNTER_API_KEY=

# --- Scraper fallback (ScrapingBee) — optional; used only when a live fetch is blocked ---
SCRAPINGBEE_API_KEY=

# --- Outlook drafting (Microsoft Graph) — optional; Monday copy still persists if absent ---
GRAPH_AUTH=app                          # 'app' (client-credentials, unattended) | 'delegated' (device-code)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=                     # app mode only
OUTREACH_MAILBOX=                        # the sender's mailbox; drafts land here

# --- Behaviour ---
OUTREACH_REVIEW=print                    # print | write   (write lets scan update the board)
OUTREACH_DAILY_CAP=5
OUTREACH_MIN_DR=30                        # source: drop linking domains below this DR
INCLUDE_ASSET_URL=1                       # put the CompanyDebt page URL in the email body
OUTREACH_SENDER_NAME=                     # e.g. "Chris Andersen" — the real person the email is from
OUTREACH_SENDER_ROLE=the Company Debt editorial team
