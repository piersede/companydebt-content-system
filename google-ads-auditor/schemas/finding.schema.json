{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://companydebt.internal/google-ads-auditor/schemas/finding.schema.json",
  "title": "Finding",
  "description": "Shared finding structure returned by all four specialist audit skills.",
  "type": "object",
  "required": [
    "finding_id",
    "source_skill",
    "category",
    "severity",
    "confidence",
    "account",
    "period",
    "evidence",
    "observation",
    "interpretation",
    "recommendation",
    "estimated_impact",
    "effort",
    "caveats"
  ],
  "additionalProperties": false,
  "properties": {
    "finding_id": {
      "type": "string",
      "description": "Unique ID, e.g. NEG-001, PMX-004."
    },
    "source_skill": {
      "type": "string",
      "enum": [
        "negative-keyword-miner",
        "search-terms-analyzer",
        "ad-performance-diagnostic",
        "performance-max-auditor"
      ]
    },
    "category": { "type": "string" },
    "severity": { "type": "string", "enum": ["low", "medium", "high"] },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "account": { "type": "string" },
    "campaign_id": { "type": "string" },
    "campaign": { "type": "string" },
    "ad_group_id": { "type": "string" },
    "ad_group": { "type": "string" },
    "period": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" }
      }
    },
    "evidence": {
      "type": "object",
      "description": "Raw metrics supporting the finding. Shape varies by skill; keys should map to fields in the relevant snapshot file.",
      "minProperties": 1
    },
    "observation": {
      "type": "string",
      "description": "What the data shows, stated factually — no judgement."
    },
    "interpretation": {
      "type": "string",
      "description": "What the observation means, kept separate from the observation itself."
    },
    "recommendation": { "type": "string" },
    "estimated_impact": { "type": "string" },
    "effort": { "type": "string", "enum": ["low", "medium", "high"] },
    "blocking_risk": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "description": "Required for negative-keyword-miner findings; risk that the recommendation blocks valuable traffic."
    },
    "evidence_label": {
      "type": "string",
      "enum": ["observed", "inferred", "not_measurable"],
      "description": "Required for performance-max-auditor findings."
    },
    "caveats": {
      "type": "array",
      "items": { "type": "string" }
    },
    "supporting_rows": {
      "type": "array",
      "description": "Optional references to raw snapshot rows, e.g. file + row identifier.",
      "items": { "type": "object" }
    }
  }
}
