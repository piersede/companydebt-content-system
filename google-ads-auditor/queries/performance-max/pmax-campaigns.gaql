-- Purpose: PMax campaign-level performance, budget, and goal config.
-- Placeholders: {{CUSTOMER_ID}} {{START_DATE}} {{END_DATE}}
-- Validated against API version: REPLACE_WITH_VERSION
-- 2026-07-20 fix: campaign.url_expansion_opt_out is not a recognised field
-- in the currently installed API version ("Unrecognized field in the
-- query"). Dropped until a working equivalent field is confirmed.

SELECT
  campaign.id,
  campaign.name,
  campaign.status,
  campaign_budget.amount_micros,
  metrics.cost_micros,
  metrics.impressions,
  metrics.clicks,
  metrics.conversions,
  metrics.conversions_value
FROM campaign
WHERE segments.date BETWEEN '{{START_DATE}}' AND '{{END_DATE}}'
  AND campaign.advertising_channel_type = 'PERFORMANCE_MAX'
ORDER BY metrics.cost_micros DESC
