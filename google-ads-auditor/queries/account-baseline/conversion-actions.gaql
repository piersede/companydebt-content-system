-- Purpose: list configured conversion actions with category and status, and
-- per-action conversion counts/value for the period — used to separate
-- primary from secondary conversions per accounts/company-debt.yml and to
-- catch conversion-tracking anomalies (e.g. an action silently disabled).
-- Placeholders: {{CUSTOMER_ID}} {{START_DATE}} {{END_DATE}}
-- Validated against API version: REPLACE_WITH_VERSION
-- 2026-07-20 fix: the conversion_action resource rejects metrics.conversions,
-- metrics.conversions_value, AND segments.conversion_action ("segment/metric
-- is incompatible with the resource in the FROM clause") — this resource
-- only exposes conversion-action config/inventory, not period performance.
-- Per-action conversion counts for a date range need a separate query
-- against campaign or ad_group segmented by segments.conversion_action —
-- not built here; this file is now inventory-only, no date filter needed.

SELECT
  conversion_action.id,
  conversion_action.name,
  conversion_action.category,
  conversion_action.status,
  conversion_action.type,
  conversion_action.primary_for_goal
FROM conversion_action
